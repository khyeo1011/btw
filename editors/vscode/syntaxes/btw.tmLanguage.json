{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "btw",
  "scopeName": "source.btw",
  "fileTypes": ["btw"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#microservice-header" },
    { "include": "#keywords" },
    { "include": "#numbers" }
  ],
  "repository": {
    "comments": {
      "match": "//.*$",
      "name": "comment.line.double-slash.btw"
    },
    "strings": {
      "begin": "\"",
      "end": "\"|$",
      "name": "string.quoted.double.btw",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.btw" }
      ]
    },
    "microservice-header": {
      "begin": "\\b(microservice)\\b(?:[ \\t]+([A-Za-z_][A-Za-z0-9_]*))?",
      "beginCaptures": {
        "1": { "name": "storage.type.btw" },
        "2": { "name": "entity.name.function.btw" }
      },
      "end": "(?=\\{)|$",
      "patterns": [
        { "include": "#comments" },
        {
          "match": "(?<=\\))[ \\t]*\\b(O[ \\t]*\\([^)]*\\))",
          "captures": { "1": { "name": "entity.name.type.btw" } }
        }
      ]
    },
    "keywords": {
      "comment": "Multi-word keywords allow any run of spaces or tabs between words. microservice is matched by #microservice-header.",
      "patterns": [
        {
          "match": "\\bi[ \\t]+use[ \\t]+arch[ \\t]+btw\\b|\\bserve\\b|\\blocalhost:[0-9]+|:wq\\b",
          "name": "keyword.control.directive.btw"
        },
        {
          "match": "\\b(?:vibe[ \\t]+check|skill[ \\t]+issue|doomscroll|touch[ \\t]+grass|ship[ \\t]+it)\\b",
          "name": "keyword.control.btw"
        },
        {
          "match": "\\bnpm[ \\t]+install(?:[ \\t]+-g)?\\b",
          "name": "storage.type.btw"
        },
        {
          "match": "\\b(?:sudo|git[ \\t]+push[ \\t]+--force|git[ \\t]+revert|git[ \\t]+log)\\b",
          "name": "keyword.other.btw"
        },
        {
          "match": "\\bconsole\\.log\\b",
          "name": "support.function.btw"
        },
        {
          "match": "\\bcurl\\b",
          "name": "support.function.btw"
        },
        {
          "match": "\\bLGTM\\b|\\b404(?![0-9])",
          "name": "constant.language.btw"
        }
      ]
    },
    "numbers": {
      "match": "\\b[0-9]+\\b",
      "name": "constant.numeric.btw"
    }
  }
}
