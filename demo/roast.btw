microservice pairs(n) O(n) {
    npm install i = 0
    doomscroll i < n {
        npm install j = 0
        doomscroll j < n {
            git push --force j = j + 1
        }
        git push --force i = i + 1
    }
    ship it i
}
microservice id(n) O(n^2) {
    ship it n
}
microservice root(n) O(sqrt n) {
    npm install i = 1
    doomscroll i * i <= n {
        git push --force i = i + 1
    }
    ship it i
}
microservice fib(n) O(2^n) {
    vibe check n < 2 { ship it n }
    ship it fib(n - 1) + fib(n - 2)
}
microservice triple(n) {
    ship it n * 3
}
microservice approve(n) O(1) {
    ship it LGTM
}
microservice audit(n) O(1) {
    git revert n
    ship it n
}
microservice early(n) O(1) {
    ship it n
    console.log n
}
