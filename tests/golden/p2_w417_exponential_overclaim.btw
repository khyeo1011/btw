i use arch btw
microservice pairs(n) O(2^n) {
    npm install total = 0
    npm install i = 0
    doomscroll i < n {
        npm install j = 0
        doomscroll j < n {
            git push --force total = total + 1
            git push --force j = j + 1
        }
        git push --force i = i + 1
    }
    ship it total
}
serve localhost:3000 {
    console.log pairs(3)
}
:wq
