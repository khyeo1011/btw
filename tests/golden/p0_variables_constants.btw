i use arch btw
npm install -g LIMIT = 10
npm install counter = LIMIT * 2
npm install -g TOTAL = counter + LIMIT
serve localhost:3000 {
    console.log LIMIT
    console.log counter
    console.log TOTAL
    git push --force counter = counter + 1
    console.log counter
    npm install local = counter - LIMIT
    console.log local
}
